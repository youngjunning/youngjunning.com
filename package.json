{
  "name": "silicon-junning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run content:prepare && next dev",
    "build": "npm run wiki:prepare && npm run suggestions:prepare && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "content:check": "node scripts/check-content.mjs",
    "schema:compare": "node scripts/compare-content-contract.mjs",
    "content:prepare": "node scripts/prepare-content.mjs",
    "wiki:prepare": "node scripts/prepare-wiki.mjs",
    "content:new": "node scripts/new-article.mjs",
    "article:sync": "node scripts/article-sync.mjs",
    "code:connect": "node scripts/connect-code.mjs",
    "code:review": "node scripts/review-code.mjs",
    "test": "node --test scripts/*.test.mjs",
    "prebuild": "npm run content:check",
    "postbuild": "node scripts/check-runtime-assets.mjs && node scripts/check-gbrain-runtime.mjs",
    "suggestions:prepare": "node scripts/prepare-suggestions.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gbrain": "https://codeload.github.com/garrytan/gbrain/tar.gz/88d3f572950a772d268b22afe0bd53c2a2f090ff",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "2.0.3",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "next": "16.4.3",
    "openai": "6.49.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwind-merge": "^3.3.0",
    "tsx": "4.23.15",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
